# Quittance — environment template
#
# NAMES ONLY. This file must never contain a value.
# Never print, log, or commit a private key, a Turnkey credential, or a KeeperHub API key (PRD §0.6).
#
# P4 (PRD §12): KeeperHub is the only path to chain. There is deliberately NO variable here for a
# private key, a mnemonic, or a seed phrase. If you find yourself wanting to add one, you are about
# to violate P4 — read AGENTS.md §4 instead.

# ---------------------------------------------------------------------------
# KeeperHub — the only path to chain
# ---------------------------------------------------------------------------
# Execute-only API key. It can trigger actions; it cannot sign arbitrary payloads.
KEEPERHUB_API_KEY=
# Base URL of the KeeperHub API. Read from configuration, never compiled in (PRD §17).
KEEPERHUB_API_BASE_URL=
# Organization / project scoping, as returned by the KeeperHub API at startup.
KEEPERHUB_ORG_ID=
KEEPERHUB_PROJECT_ID=
# Identifier of the KeeperHub-managed Turnkey wallet used by the gate. An identifier, not a key.
KEEPERHUB_WALLET_ID=
# Shared secret used to authenticate inbound webhook triggers.
KEEPERHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Chain access — READ ONLY
# ---------------------------------------------------------------------------
# A read-only RPC endpoint. Used for reading receipts, logs and balances, and for
# eth_getStorageAt when resolving a token proxy's implementation so its ABI can be read at
# runtime (§17 — no ABI is compiled in).
# A write-capable client built on this URL is a P4 violation and fails CI.
RPC_URL_READONLY=
# CAIP-2 network identifier, resolved from the KeeperHub chain list at startup.
# Do not hardcode a chain id anywhere in apps/ or packages/ (PRD §17).
NETWORK_CAIP2=

# ---------------------------------------------------------------------------
# Gate service
# ---------------------------------------------------------------------------
GATE_PORT=
# Publicly reachable base URL of the gate, used in receipts and webhook registration.
GATE_PUBLIC_URL=
# The address the conditional fee is paid TO: the KeeperHub organisation wallet (D-009).
# An address is a dated protocol fact and is never compiled in (§17). It lives here only.
GATE_FEE_RECIPIENT=
# Fee charged on DELIVERED_AS_ADVERTISED, in atomic units of the asset the buyer authorises.
GATE_FEE_ATOMIC=
# Response retention policy: `full` or `none`. `none` is hash-only mode (PRD §6).
GATE_RETAIN_MODE=

# ---------------------------------------------------------------------------
# Probes (PRD §17)
# ---------------------------------------------------------------------------
# Comma-separated list of live x402 resource URLs to probe for advertised terms.
# These are inputs, not compiled-in facts. The file that reads them holds no defaults.
PROBE_X402_TARGETS=
# Where the discovery index is queried for listed resources.
PROBE_DISCOVERY_URL=

# ---------------------------------------------------------------------------
# Demo buyer wallet — NOT part of the shipped product
# ---------------------------------------------------------------------------
# §12 P4 forbids a private key in apps/ or packages/, and there is none there.
# The BUYER is a separate actor (§7) that signs its own payments with its own wallet.
# For the demo we act as the buyer, so the key lives here and the signer lives in
# internal/, which is gitignored (AGENTS.md HB-7). Nothing that ships can sign.
#
# Use a FRESH wallet holding only campaign funds. Treat it as burnable.
BUYER_PRIVATE_KEY=
BUYER_ADDRESS=

# ---------------------------------------------------------------------------
# Baseline endpoint — labelled PROJECT_BASELINE, never counted as adoption
# ---------------------------------------------------------------------------
# Our own deliberately-failing endpoint, used for adversarial tests only (PRD §14).
# Every run against it is labelled PROJECT_BASELINE in the receipt, in the UI, and in claims.json.
BASELINE_ENDPOINT_URL=

# ---------------------------------------------------------------------------
# Web surfaces (P4)
# ---------------------------------------------------------------------------
# Base URL the web app reads receipts from. The /verify page must work without it.
WEB_RECEIPTS_API_URL=
